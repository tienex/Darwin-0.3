# BSD layer device support

bsd/dev/x86_64/conf.c		standard
bsd/dev/x86_64/cons.c		standard

# Note: This is a basic x86-64 implementation with stub functions.
# Full implementation would require:
# - Startup/bootstrap code (start.s, locore.s)
# - IDT/GDT management (idt.c, gdt.c)
# - Interrupt handling (intr.c)
# - I/O primitives (io_prim.c)
# - Memory management helpers (vm_machdep.c)
# - FPU/SSE support (fp_support.c, fpu.s)
# - System call interface (machdep_call.c, sys_machdep.c)
# - Context switching (cswtch.s)
# - APIC/interrupt controller support
# - Device drivers
