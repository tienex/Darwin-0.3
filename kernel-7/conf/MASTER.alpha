# Copyright (c) 1986 Carnegie-Mellon University
# All rights reserved.  The CMU software License Agreement
# specifies the terms and conditions for use and redistribution.
#
######################################################################
#
#  Master Alpha configuration file (see the master machine independent
#  configuration file for a description of the file format).
#
######################################################################
#
#  Alpha Architecture Support
#
#  MULTIPROCESSOR SUPPORT (select exactly one)
#	multi = support multiple processors
#	uni   = supports single processor
#
#  SPECIAL CHARACTERISTICS (select any combination)
#	gdb        = GNU kernel debugger
#	posix_kern = POSIX support
#
#  PALcode Support:
#	pal_unix = UNIX (Digital UNIX/Tru64) PALcode (default)
#	pal_nt   = Windows NT PALcode
#	pal_vms  = OpenVMS PALcode
#
#  CPU TYPE (select any combination)
#	ev4   = 21064 (Alpha EV4)
#	ev5   = 21164 (Alpha EV5)
#	ev6   = 21264 (Alpha EV6)
#
######################################################################
#
#  Standard Alpha Configurations:
#  -------- ----- ---------------
#
#  RELEASE = [alpha ev5 pal_unix mach medium event vol pst gdb kernobjc libdriver fixpri simple_clock mdebug kernserv driverkit uxpr kernstack ipc_compat ipc_debug nfsclient nfsserver quota fifo fdesc union portal ffs cd9660 compat_43 revfs nbc]
#  DEBUG = [alpha ev5 pal_unix mach medium event vol pst gdb kernobjc libdriver_g fixpri debug simple_clock mdebug kernserv driverkit xpr_debug uxpr kernstack ipc_compat ipc_debug nfsclient nfsserver quota fifo fdesc union portal ffs cd9660 compat_43 diagnostic revfs nbc]
#
######################################################################
#
machine		"alpha"						# <alpha>
cpu		"alpha"						# <alpha>

makeoptions	CCONFIGFLAGS = "-g -O2 -fno-omit-frame-pointer"	# <gdb>
makeoptions	CCONFIGFLAGS = "-O2"				# <!gdb>
makeoptions	RELOC = "fffffc0000300000"			# <alpha>
makeoptions	SYMADDR = "fffffc0000800000"			# <alpha>

options		GDB		# GNU kernel debugger		# <gdb>
options		DEBUG		# general debugging code	# <debug>
options		SHOW_SPACE	# print size of structures	# <debug>
options		EVENTMETER	# event meter support		# <debug>
options		UXPR		# user-level XPR package	# <uxpr>
config		mach_kernel	swap generic			# <mach>

options		EVENT						# <event>

#
# Alpha CPU types
#
options		ALPHA_EV4					# <ev4>
options		ALPHA_EV5					# <ev5>
options		ALPHA_EV6					# <ev6>

#
# PALcode variant selection
#
options		PAL_UNIX					# <pal_unix>
options		PAL_NT						# <pal_nt>
options		PAL_VMS						# <pal_vms>

#
#  Ipl measurement system
#
pseudo-device	iplmeas						# <iplmeas>

#
#  NFS measurement system
#
pseudo-device	nfsmeas						# <nfsmeas>

#
#  Removable Volume support
#
pseudo-device	vol						# <vol>

#
#  Point-to-Point Protocol support
#
pseudo-device ppp 2						# <ppp>
